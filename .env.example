# Nexus Portal - Environment Configuration
# Copy this file to .env or .env.local and fill in values. Never commit real secrets.

# General Environment
QA_ENV=local
PORT=3100

# Base & Target URLs
QA_BASE_URL=http://localhost:3000
QA_API_URL=http://localhost:3100

# Git & Repository Access
GITHUB_TOKEN=
QA_VAULT_GIT_READONLY=

# Vault Credentials (Format: JSON string with username, password, token, or fields)
# Example: QA_VAULT_PILOT_ADMIN='{"username":"admin@local","password":"secretpassword"}'
QA_VAULT_SAMPLE=

# Allowlist (Optional override)
# QA_ALLOWLIST=localhost,127.0.0.1,*.local
